# Copy to .env.local and fill in. Never commit real keys.

# Required: Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: override models (defaults chosen for lowest cost – see docs/adr/0003)
# NATTERLY_CHAT_MODEL=claude-haiku-5-5
# NATTERLY_FEEDBACK_MODEL=claude-haiku-5-5

# Optional but recommended for any public deployment: beta testers must enter this code.
# Leave empty for local development.
NATTERLY_ACCESS_CODE=

# Optional: requests per user (IP) per hour across all AI endpoints. Default 60.
# NATTERLY_RATE_LIMIT_PER_HOUR=60
